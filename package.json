{
  "name": "career-os",
  "version": "1.0.0",
  "description": "CareerOS — Personal Knowledge Compiler",
  "private": true,
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.js",
    "check-structure": "node scripts/check-structure.js",
    "compile": "node apps/cli/dist/index.js compile --verbose",
    "validate": "node apps/cli/dist/index.js validate --verbose",
    "build:ontology": "cd packages/ontology && tsc",
    "build:graph": "cd packages/graph && tsc",
    "build:graph-store": "cd packages/graph-store && tsc",
    "build:compiler": "cd packages/compiler && tsc",
    "build:conversation": "cd packages/conversation && tsc",
    "build:resume": "cd packages/resume && tsc",
    "build:embedding": "cd services/embedding && tsc",
    "build:retriever": "cd services/retriever && tsc",
    "build:llm": "cd services/llm && tsc",
    "build:cli": "cd apps/cli && tsc",
    "build": "npm run build:ontology && npm run build:graph && npm run build:graph-store && npm run build:compiler && npm run build:conversation && npm run build:resume && npm run build:embedding && npm run build:retriever && npm run build:llm && npm run build:cli",
    "query": "node apps/cli/dist/index.js query",
    "ask": "node apps/cli/dist/index.js ask",
    "resume": "node apps/cli/dist/index.js resume",
    "web": "npm run dev --workspace=@career-os/web",
    "web:build": "npm run build --workspace=@career-os/web",
    "index:embeddings": "node scripts/index-embeddings.mjs",
    "qdrant:up": "docker compose up -d qdrant",
    "qdrant:down": "docker compose down",
    "benchmark:retrieval": "node scripts/benchmark-retrieval.mjs",
    "test": "npm run test --workspace=packages/compiler && npm run test --workspace=packages/graph && npm run test --workspace=packages/graph-store && npm run test --workspace=packages/conversation && npm run test --workspace=packages/resume && npm run test --workspace=services/embedding && npm run test --workspace=services/retriever && npm run test --workspace=services/llm"
  },
  "keywords": [],
  "author": "Bang Thai Minh",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
